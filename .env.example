PORT=5000
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Use the same Better Auth secret configured by the frontend auth server.
BETTER_AUTH_SECRET=

# Generate a separate random secret with at least 32 characters.
JWT_SECRET=

# Generate one strong value and use it in both frontend and backend environments.
HOMEFIX_PAYMENT_API_SECRET=

# Use the Stripe secret key for the same mode/account used by the frontend.
STRIPE_SECRET_KEY=

# Configure a Stripe webhook endpoint for POST /webhooks/stripe and set its
# signing secret here. For local development, use the secret printed by Stripe CLI.
STRIPE_WEBHOOK_SECRET=
